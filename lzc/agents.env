# Agent CLI versions baked into the packaged Paseo image.
#
# These are the four agents upstream's Docker docs use as the example child
# image (docs/docker.md), plus GitHub Copilot. Every other provider in Paseo's
# catalog runs through `npx -y <pkg>@<pin>` and needs no image change.
#
# Bump deliberately: run `npm view <pkg> version` and update the pins, then
# rebuild the lpk. Keep this file the only place versions live.

# Paseo's Claude provider spawns `claude`.
CLAUDE_CODE_VERSION=2.1.303
# Paseo's Codex provider spawns `codex`.
CODEX_VERSION=0.163.0
# Paseo's OpenCode provider spawns `opencode`.
OPENCODE_VERSION=1.19.3
# Paseo's Copilot provider spawns `copilot`.
COPILOT_VERSION=1.0.98
